{
  "name": "dbeaty-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/server\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/server && npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "test": "npm run test --workspace=apps/server && node scripts/run_visual_verification.js",
    "test:server": "npm run test --workspace=apps/server",
    "test:visual": "node scripts/run_visual_verification.js",
    "test:effects": "node scripts/test_new_effects_sensitivity.js",
    "verify:effects": "node scripts/verify_new_effects.js",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
